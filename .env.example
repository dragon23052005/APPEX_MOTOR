# Copy to .env and replace both password placeholders with different random values.
# Keep values unquoted and simple: Spring imports this as Java properties.
MYSQL_PORT=3306
MYSQL_USER=apex_app
MYSQL_PASSWORD=replace_with_random_app_password
MYSQL_ROOT_PASSWORD=replace_with_different_random_root_password
DB_HOST=127.0.0.1
MYSQL_SSL_MODE=PREFERRED
